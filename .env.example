# Copy to .env for local development. Never commit .env.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# Public-build generation defaults to Gemini when this is set.
# Use a real key locally only. For the live Worker, set it as a secret:
#   cd cloudflare/container-worker && bun x wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# Optional overrides:
# MOCKGEN_MODEL=gemini-3.5-flash
# MOCKGEN_GEMINI_MODEL=gemini-3.5-flash
# MOCKGEN_PUBLIC_MODEL=gemini-3.5-flash
# MOCKGEN_GEMINI_REASONING_EFFORT=none
# Cloudflare/Wrangler (set with `wrangler secret put` in deployment)
TURNSTILE_SECRET_KEY=
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_BUCKET=exampapers
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Keep the original local-build cover (0) or use the old generic cover (1)
MOCKGEN_PUBLIC_STRIP_BRANDING=0

# PDF export: word (Windows local default) or libreoffice (container)
# MOCKGEN_PDF_ENGINE=word

# Public footer details
MOCKGEN_CONTACT_EMAIL=auzair1990@gmail.com
MOCKGEN_REPO_URL=https://github.com/jerkfish/paper-generator
