# Copy to .env for local development. Never commit .env.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# Cloudflare/Wrangler (set with `wrangler secret put` in deployment)
TURNSTILE_SECRET_KEY=
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_BUCKET=exampapers
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Keep the original local-build cover (0) or use the old generic cover (1)
MOCKGEN_PUBLIC_STRIP_BRANDING=0

# Public footer details
MOCKGEN_CONTACT_EMAIL=auzair1990@gmail.com
MOCKGEN_REPO_URL=https://github.com/jerkfish/paper-generator
