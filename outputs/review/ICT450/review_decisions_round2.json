t-size: 16px;\n        }\n\n        th, td {\n            border: 1px solid #000;\n            padding: 10px 8px;\n            text-align: center;\n            vertical-align: middle;\n        }\n\n        th {\n            font-weight: bold;\n            background-color: #fff;\n        }\n\n        /* Specific Column Widths to match image */\n        th:nth-child(1) { width: 12%; }\n        th:nth-child(2) { width: 18%; }\n        th:nth-child(3) { width: 18%; }\n        th:nth-child(4) { width: 10%; }\n        th:nth-child(5) { width: 20%; }\n        th:nth-child(6) { width: 22%; }\n\n    </style>\n</head>\n<body>\n\n    <div class=\"document-container\">\n        \n        <!-- Header -->\n        <div class=\"header\">\n            <h1>IT CREATIVE SOLUTIONS SDN. BHD.</h1>\n            <h2>EMPLOYEE MONTHLY EVALUATION RESULT</h2>\n            <h3>(FEBRUARY 2024)</h3>\n        </div>\n\n        <!-- Employee Details -->\n        <div class=\"employee-details\">\n            <div class=\"detail-row\">\n                <div class=\"detail-label\">Employee ID</div>\n                <div class=\"detail-colon\">:</div>\n                <div class=\"detail-value\">303303</div>\n            </div>\n            <div class=\"detail-row\">\n                <div class=\"detail-label\">Employee Name</div>\n                <div class=\"detail-colon\">:</div>\n                <div class=\"detail-value\">Siti Nur Fadilah</div>\n            </div>\n            <div class=\"detail-row\">\n                <div class=\"detail-label\">Employment Year</div>\n                <div class=\"detail-colon\">:</div>\n                <div class=\"detail-value\">2000</div>\n            </div>\n            <div class=\"detail-row\">\n                <div class=\"detail-label\">Department</div>\n                <div class=\"detail-colon\">:</div>\n                <div class=\"detail-value\">S1 - Software Development</div>\n            </div>\n            <div class=\"detail-row\">\n             