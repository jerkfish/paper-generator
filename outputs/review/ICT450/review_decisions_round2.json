tomer-info\">\n                <div class=\"row\">\n                    <div class=\"cell cell-label\">Customer No:</div>\n                    <div class=\"cell\">153</div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"cell cell-label\">Customer Name:</div>\n                    <div class=\"cell\">Puan Adriana Yusuf</div>\n                </div>\n                <div class=\"row\" style=\"border-bottom: none;\">\n                    <div class=\"cell cell-label\">Customer<br>Address:</div>\n                    <div class=\"cell\">Taman Rasah Jaya,<br>Seremban</div>\n                </div>\n            </div>\n            \n            <div class=\"invoice-info\">\n                <div class=\"row\">\n                    <div class=\"cell\" style=\"font-size: 18px;\">INVOICE</div>\n                </div>\n                <div class=\"row\">\n                    <div class=\"cell cell-label\">No:</div>\n                    <div class=\"cell\">2088</div>\n                </div>\n                <div class=\"row\" style=\"border-bottom: none;\">\n                    <div class=\"cell cell-label\">Date:</div>\n                    <div class=\"cell\">26 August 2019</div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Item Table -->\n        <table>\n            <thead>\n                <tr>\n                    <th>Item No</th>\n                    <th>Item Name</th>\n                    <th>Model</th>\n                    <th>Quantity</th>\n                    <th>Item<br>Price</th>\n                    <th>Total</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>CRB101</td>\n                    <td>Electric Kids Car</td>\n                    <td>Buggati</td>\n                    <td>1</td>\n                    <td>559.00</td>\n                    <td>559.00</td>\n                </tr>\n                <tr>\n                    