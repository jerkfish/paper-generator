ical-align: top;\n        }\n\n        /* Specific Table Styles */\n        .details-table td:first-child {\n            width: 30%;\n        }\n\n        .details-table td {\n            height: 25px; /* Gives the rows some height */\n        }\n\n        .menu-table th {\n            text-align: center;\n            font-weight: normal;\n        }\n\n        .menu-table td {\n            height: 40px;\n        }\n\n        .menu-table .row-num {\n            width: 30px;\n            text-align: center;\n            vertical-align: top;\n        }\n        \n        .menu-table .col-qty {\n            width: 20%;\n        }\n\n        .facility-header {\n            text-align: center !important;\n            vertical-align: middle !important;\n            font-weight: normal;\n        }\n        \n        .facility-desc-header {\n            text-align: center !important;\n            vertical-align: middle !important;\n            font-weight: normal;\n        }\n\n        /* Footer Section */\n        .footer {\n            margin-top: 30px;\n            font-size: 18px;\n        }\n\n        .footer p {\n            margin-bottom: 10px;\n        }\n        \n        .total-payment {\n            font-weight: bold;\n        }\n\n        .payment-options {\n            display: flex;\n            align-items: center;\n            gap: 15px;\n            margin-top: 5px;\n        }\n\n        .payment-options label {\n            display: flex;\n            align-items: center;\n            cursor: pointer;\n        }\n\n        .payment-options input[type=\"checkbox\"] {\n            margin-right: 5px;\n            width: 15px;\n            height: 15px;\n        }\n\n        .thank-you {\n            text-align: center;\n            font-weight: bold;\n            margin-top: 50px;\n            font-size: 20px;\n            letter-spacing: 1px;\n        }\n\n        /* Utility */\n        .bold {\n            font-weight: bold;\n        }\n    </style>\n</head>