      "stem": "Text is an essential element in a multimedia project. Its shape, size, design, colour, arrangement and linking all affect the message.",
      "parts": [
        {
          "label": "a",
          "marks": 3,
          "text": "State TWO reasons sans serif is mostly used for screen display and serif is used for printed material.",
          "answer": "Sans serif is cleaner at screen sizes; serif aids reading in print."
        },
        {
          "label": "b",
          "marks": 3,
          "text": "Describe TWO roles of hypertext in multimedia.",
          "answer": "It links related content and supports non-linear navigation."
        },
        {
          "label": "c",
          "marks": 4,
          "text": "Explain how text can have a massive impact on an informative multimedia project in the link and HTML context.",
          "answer": "Clear headings and links guide users through HTML pages and make the information easier to scan and follow."
        }
      ]
    },
    {
      "number": "D3",
      "part": "D",
      "kind": "structured",
      "marks": 10,
      "topic": "authoring_interactivity",
      "stem": "A company wants an interactive product demonstration that runs on a kiosk and on the web.",
      "parts": [
        {
          "label": "a",
          "marks": 2,
          "text": "State TWO features to consider when choosing authoring software.",
          "answer": "Interactivity support and export formats are important features."
        },
        {
          "label": "b",
          "marks": 3,
          "text": "Explain the interactivity level suitable for the demonstration.",
          "answer": "A medium level with menus and buttons lets users explore without overwhelming them."
        },
        {
          "label": "c",
          "marks": 5,
          "text": "Explain TWO authoring tool categories appropriate for this project.",
          "answer": "Card-based tools suit structured screens; timeline-based tools suit animation and media sequencing."
        }
      ]
    },
    {
      "number": "D4",
      "part": "D",
      "kind": "structured",
      "marks": 10,
      "topic": "web_hypermedia",
      "stem": "A museum wants a website that presents its collection and lets visitors explore related exhibits.",
      "parts": [
        {
          "label": "a",
          "marks": 2,
          "text": "State TWO differences between linear and non-linear navigation.",
          "answer": "Linear follows a fixed sequence; non-linear lets users choose their own path."
        },
        {
          "label": "b",
          "marks": 4,
          "text": "Describe TWO roles of hyperlinks in the website.",
          "answer": "They connect related exhibits and let users move between pages."
        },
        {
          "label": "c",
          "marks": 4,
          "text": "Explain how streaming and compression affect multimedia delivery on the web.",
          "answer": "Compression reduces file size for faster transfer; streaming lets audio or video play while it downloads."
        }
      ]
    }
